# GitHub integration
# Use a fine-grained PAT with only the read permissions FRIDAY needs.
# Never commit the real token to Git.
GITHUB_USERNAME=your_github_username
GITHUB_PAT=your_github_personal_access_token

# NVIDIA NIM integration
# NVIDIA_API_KEY is required for live NVIDIA inference.
# The model and base URL have safe defaults in providers/nvidia/config.py.
NVIDIA_API_KEY=your_nvidia_api_key
# NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
