# GitHub App user authorization
# Create a GitHub App and enable user authorization (OAuth).
# Callback URL for local development:
# http://127.0.0.1:8000/auth/github/callback
# Keep the client secret and encryption key private.
GITHUB_APP_CLIENT_ID=your_github_app_client_id
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback
GITHUB_ENCRYPTION_KEY=your_fernet_encryption_key
GITHUB_FRONTEND_URL=http://localhost:3000

# Optional legacy fallback for development only.
# Prefer GitHub App OAuth. Do not commit a real PAT.
GITHUB_USERNAME=your_github_username
GITHUB_PAT=

# NVIDIA NIM integration
# NVIDIA_API_KEY is required for live NVIDIA inference.
NVIDIA_API_KEY=your_nvidia_api_key
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
